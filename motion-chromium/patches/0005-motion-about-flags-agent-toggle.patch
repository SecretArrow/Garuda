 .../org/chromium/chrome/browser/flags/ChromeFeatureList.java    | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/chrome/browser/flags/android/java/src/org/chromium/chrome/browser/flags/ChromeFeatureList.java b/chrome/browser/flags/android/java/src/org/chromium/chrome/browser/flags/ChromeFeatureList.java
index 6b7c9d0e..2e4f5a6b 100644
--- a/chrome/browser/flags/android/java/src/org/chromium/chrome/browser/flags/ChromeFeatureList.java
+++ b/chrome/browser/flags/android/java/src/org/chromium/chrome/browser/flags/ChromeFeatureList.java
@@ -3204,3 +3204,7 @@
     public static final String OMNIBOX_AUX_SEARCH = "OmniboxAuxSearch";
     public static final String PAGE_VISIBILITY = "PageVisibility";
+    // Motion (0005): master toggle for the autonomous agent bridge.
+    // See motion/java/src/com/motion/chromium/MotionAgentBridge.java and
+    // motion/security/SECURITY_NOTES.md for the capability chain.
+    public static final String MOTION_AGENT_TOGGLE = "MotionAgentToggle";
     public static final String READ_LATER = "ReadLater";
@@ -3460,2 +3464,3 @@
         sExperiments.put(PAGE_VISIBILITY, PAGE_VISIBILITY);
+        sExperiments.put(MOTION_AGENT_TOGGLE, MOTION_AGENT_TOGGLE);
         sExperiments.put(READ_LATER, READ_LATER);
