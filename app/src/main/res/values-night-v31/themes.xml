<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ NIGHT baseline: dark platform theme + LIGHT bar icons. Qualifier
     night+v31 beats plain v31, so this wins over values-v31 in dark mode. -->
<resources>
    <style name="Theme.Motion" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowSplashScreenBackground">#1A1C2E</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
