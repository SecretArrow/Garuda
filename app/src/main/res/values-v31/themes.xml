<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ DAY baseline: light platform theme + DARK bar icons.
     (values-v31 outranks values-night — the night+API31 variant lives in
     values-night-v31/themes.xml.) -->
<resources>
    <style name="Theme.Motion" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">#1A1C2E</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
